{
  "name": "johnnyli-portfolio-quality",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css",
    "design-system:update": "node scripts/update-design-system.mjs",
    "design-system:sync": "node scripts/sync-design-system.mjs",
    "design-system:check": "npm run design-system:sync && git diff --exit-code -- assets/design-system",
    "design-system:integration": "node scripts/validate-design-system-integration.mjs",
    "design-system:conformance": "node node_modules/@johnnyzli/web-design-system/scripts/conformance-runner.mjs",
    "performance:baseline": "node scripts/performance-baseline.mjs",
    "lint:html": "html-validate \"index.html\" \"projects/**/*.html\"",
    "lint:css": "stylelint \"**/*.css\" --ignore-pattern \"assets/design-system/**/*.css\""
  },
  "dependencies": {
    "@johnnyzli/web-design-system": "github:JohnnyZLi/Web-Design-System#abb6c44f588afe09e8f593a8c467b564ac9fef86"
  },
  "devDependencies": {
    "html-validate": "11.5.6",
    "pa11y": "9.1.1",
    "stylelint": "17.14.1"
  }
}
