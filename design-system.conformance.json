{
  "schemaVersion": "1.0.0",
  "product": "portfolio",
  "outputDirectory": "design-system-conformance",
  "rules": {
    "DS-DIST-001": {
      "evidence": [
        {"type": "json-equals", "file": "design-system.lock.json", "path": "package", "value": "@johnnyzli/web-design-system"},
        {"type": "json-matches", "file": "design-system.lock.json", "path": "version", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
        {"type": "json-matches", "file": "design-system.lock.json", "path": "sourceCommit", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "DS-DIST-002": {
      "evidence": [
        {"type": "contains", "file": "scripts/sync-design-system.mjs", "values": ["design-system.lock.json", "styles/content-primitives.css", "dependency.endsWith(`#${sourceCommit}`)"]},
        {"type": "contains", "file": "scripts/validate-design-system-integration.mjs", "values": ["Generated asset source commit is not pinned", "Portfolio package dependency does not match the design-system lock"]}
      ]
    },
    "DS-HEADER-001": {
      "evidence": [
        {"type": "contains", "file": "index.html", "values": ["jl-global-header", "jl-global-header__inner", "jl-site-identity"]},
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["headerInnerHeight", "expectedInnerHeight", "expectedOuterHeight"]}
      ]
    },
    "DS-SITES-001": {
      "evidence": [
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["Sites menu does not contain three links", "Sites menu current-page state is incorrect", "aria-current=\"page\""]}
      ]
    },
    "DS-SITES-002": {
      "evidence": [
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["Sites menu did not close with Escape", "Sites button did not regain focus after Escape", "compact Menu did not regain focus after Escape"]}
      ]
    },
    "DS-PRIMITIVE-001": {
      "evidence": [
        {"type": "contains", "file": "scripts/validate-design-system-integration.mjs", "values": ["Case-study actions still duplicate shared structure", "Standalone content-primitives asset"]}
      ]
    },
    "DS-RESP-001": {
      "evidence": [
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["width: 320", "document overflow"]}
      ]
    },
    "DS-RESP-002": {
      "status": "manual-pending",
      "reason": "Actual 200 percent browser zoom remains a manual release check; the automated narrow-desktop viewport is not labeled as zoom."
    },
    "DS-A11Y-001": {
      "evidence": [
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["page.keyboard.press('Escape')", "regain focus after Escape", "aria-expanded"]}
      ]
    },
    "DS-A11Y-002": {
      "status": "manual-pending",
      "reason": "Real forced-colors and assistive-technology review remains a recorded manual release check."
    },
    "DS-STATE-002": {
      "evidence": [
        {"type": "contains", "file": ".github/workflows/visual-audit.yml", "values": ["aria-current=\"page\"", "current-page state"]}
      ]
    },
    "DS-OWN-001": {
      "evidence": [
        {"type": "contains", "file": "scripts/validate-design-system-integration.mjs", "values": ["Portfolio wrapper reimplements shared behavior", "Motion script still performs header enhancement"]}
      ]
    },
    "DS-WORKFLOW-001": {
      "evidence": [
        {"type": "matches", "file": ".github/workflows/design-system-sync.yml", "pattern": "uses: JohnnyZLi/Web-Design-System/.github/workflows/consumer-design-system-sync\\.yml@[0-9a-f]{40}"},
        {"type": "not-contains", "file": ".github/workflows/design-system-sync.yml", "values": ["gh pr create", "git push"]}
      ]
    },
    "DS-TEST-001": {
      "evidence": [
        {"type": "file-exists", "file": ".github/workflows/visual-audit.yml"},
        {"type": "contains", "file": ".github/workflows/design-system-conformance.yml", "values": ["consumer-conformance.yml@", "design-system:integration", "design-system:conformance"]}
      ]
    },
    "DS-PERF-001": {
      "status": "manual-pending",
      "reason": "Reviewed bundle and user-experience performance baselines have not yet been recorded."
    }
  }
}
